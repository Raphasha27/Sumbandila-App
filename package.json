{
  "//": "Unified CI Trigger - passing build",
  "name": "sumbandila-enterprise-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "npm run lint && npm run build --workspace=@sumbandila/web",
    "check-env": "node scripts/integrity-check.js"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.21.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "tar": "^6.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-svg": "15.12.1",
    "eslint": "^9.21.0",
    "jspdf": "^4.2.1",
    "dompurify": "^3.4.1",
    "@xmldom/xmldom": "^0.8.13"
  }
}
