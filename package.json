{
  "//": "Unified CI Trigger - passing build",
  "name": "sumbandila-enterprise-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "npm run security-audit && npm run build --workspace=@sumbandila/web",
    "security-audit": "py scripts/local_security_audit.py",
    "check-env": "node scripts/integrity-check.js",
    "sync-readme": "node scripts/sync-readme.js",
    "verify-deployment": "node scripts/verify-deployment.js",
    "health-monitor": "node scripts/health-monitor.js",
    "daily-commit": "node scripts/daily-commit.js",
    "github-dashboard": "node scripts/github-dashboard.js",
    "upgrade-all": "npm update --workspaces && npm audit fix",
    "check-updates": "npm outdated --workspaces"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.21.0",
    "yallist": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "next": "16.2.12",
    "sharp": "0.35.3",
    "brace-expansion": "^2.0.0",
    "tar": "^6.2.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-native-svg": "15.12.1",
    "eslint": "^9.21.0",
    "jspdf": "^4.2.1",
    "dompurify": "^3.4.1",
    "@xmldom/xmldom": "^0.8.13",
    "lucide-react": "^0.574.0",
    "lucide-react-native": "^0.574.0",
    "uuid": "^14.0.0",
    "postcss": "^8.5.10"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "lightningcss": "^1.29.1",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  }
}
