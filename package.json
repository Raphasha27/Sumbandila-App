{
  "//": "Unified CI Trigger - passing build",
  "name": "sumbandila-enterprise-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check-env": "node scripts/integrity-check.js"
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-svg": "15.12.1"
  }
}
