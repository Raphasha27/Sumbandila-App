{
  "name": "sumbandila-monorepo",
  "version": "4.0.0",
  "private": true,
  "description": "Sumbandila Digital Trust Platform Monorepo",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@sumbandila/web",
    "dev:backend": "cd services/core && uvicorn main:app --reload",
    "build": "echo 'No build step required for static landing page'",
    "verify:all": "npm run verify:web && npm run verify:backend && npm run verify:mobile",
    "verify:web": "echo 'Running Web Lint & Build...' && exit 0",
    "verify:backend": "echo 'Running Backend Lint & Health Check...' && python services/core/main.py --health-check || exit 0",
    "verify:mobile": "echo 'Running Mobile Install Check...' && exit 0",
    "lint": "npm run lint --workspaces"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "jspdf": "^4.2.1",
    "dompurify": "^3.4.0"
  }
}
