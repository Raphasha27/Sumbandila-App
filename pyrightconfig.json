{
  "include": ["services/core", "scripts", "ai"],
  "exclude": ["**/node_modules", "**/__pycache__", "services/core/.venv"],
  "pythonVersion": "3.11",
  "typeCheckingMode": "off",
  "reportMissingImports": false,
  "reportMissingModuleSource": false,
  "venvPath": "services/core",
  "venv": ".venv",
  "executionEnvironments": [
    {
      "root": "services/core",
      "extraPaths": ["../../packages", "../../"]
    },
    {
      "root": "services/ai",
      "extraPaths": ["../../packages", "../../"]
    }
  ]
}
