# Sumbandila Registry Sentinel - Environment Template
# Copy to .env and fill in values

# API Configuration
PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/sumbandila
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=generate_a_secure_random_string_here
ARGON2_SALT=optional_salt

# AI Engine
MODEL_PATH=ai/fraud_model.pkl

# Blockchain (Optional for Dev)
BLOCKCHAIN_NODE_URL=https://eth-mainnet.g.alchemy.com/v2/your-key

# Deployment
VERCEL_ENV=development
