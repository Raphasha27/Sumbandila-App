{
  "version": 2,
  "name": "sumbandila-app",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".next",
  "buildCommand": "cd apps/portal && next build",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/apps/portal/$1"
    }
  ],
  "github": {
    "silent": true,
    "enabled": true
  }
}
