{
  "version": 2,
  "name": "sumbandila-app",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "destination": "/apps/landing-page/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/apps/web/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/apps/landing-page/$1"
    }
  ],
  "github": {
    "silent": true,
    "enabled": true
  }
}
